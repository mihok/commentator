# Required
OPENAI_API_KEY=sk-...

# Who's in the booth: biff | nigel | coach | dee   (see src/shared/personas.js)
COMMENTATOR_PERSONA=biff
# 1 = friendly ribbing, 2 = sarcastic (default), 3 = full roast
COMMENTATOR_SPICE=2
# What the commentator calls you on air
COMMENTATOR_USER_NAME=

# Optional overrides
# COMMENTATOR_VOICE=ash                 # any GPT-Live built-in voice; defaults to the persona's voice
# COMMENTATOR_LIVE_MODEL=gpt-live-1
# COMMENTATOR_VISION_MODEL=gpt-5.4-mini # any vision-capable Responses model
# COMMENTATOR_VISION_REASONING=low      # none|minimal|low|medium|high, or empty to omit
# COMMENTATOR_IMAGE_DETAIL=auto         # low|high|auto
# COMMENTATOR_DISPLAY=cursor            # cursor (display under the mouse) | primary
# COMMENTATOR_CORNER=bottom-right       # top-left|top-right|bottom-left|bottom-right
# COMMENTATOR_MIC=on                    # start with the mic on or off

# Pacing (milliseconds unless noted)
# COMMENTATOR_CAPTURE_INTERVAL_MS=4000  # how often the screen is sampled locally (free)
# COMMENTATOR_MIN_ANALYSIS_GAP_MS=8000  # min time between vision calls (costs money)
# COMMENTATOR_MIN_GAP_MS=20000          # min time between unprompted on-air calls
# COMMENTATOR_BANTER_QUIET_MS=12000     # hold unprompted commentary this long after you speak
# COMMENTATOR_IDLE_ROAST_MS=120000      # call out a screen that hasn't changed in this long
# COMMENTATOR_CHANGE_THRESHOLD=0.035    # 0..1 visual change needed before the spotter looks
# COMMENTATOR_INTEREST_THRESHOLD=5      # 0..10 how notable a moment must be to call it
# COMMENTATOR_QUIET_MS=300000           # how long "shut up" buys you
